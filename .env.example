# === Obrigatório ===
# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID da aplicação (Developer Portal > General Information > Application ID)
CLIENT_ID=

# === Opcional ===
# ID do servidor de testes. Se preenchido, `npm run deploy` registra os comandos
# só nesse servidor (instantâneo). Sem ele, o registro é global (leva até 1h).
GUILD_ID=

# IDs dos donos do bot, separados por vírgula. Ignoram cooldowns e liberam o /dono.
# Pode deixar vazio: o bot pergunta ao Discord quem criou a aplicação e usa essa conta.
# Preencha só para dar acesso de dono a mais alguém.
OWNER_IDS=

# Caminho do banco SQLite (padrão: ./data/bot.db)
DATABASE_PATH=./data/bot.db

# Nível de log: debug | info | warn | error (padrão: info)
LOG_LEVEL=info

# Registra os slash commands sozinho toda vez que o bot liga.
# Deixe true se você hospeda num lugar sem terminal (assim não precisa rodar
# `npm run deploy` na mão). Padrão: false.
AUTO_DEPLOY=false

# Sharding: auto | off | <número> (padrão: auto)
#   auto  = o Discord informa quantos shards a conta precisa
#   off   = processo único (recomendado para desenvolver)
#   3     = força exatamente 3 shards
# NÃO use os nomes SHARDS ou SHARD_COUNT: essas variáveis são definidas pelo
# próprio discord.js em cada processo filho e sobrescrevê-las quebra o roteamento.
SHARDING=auto

# Chave da API da Anthropic. Sem ela o comando /ia fica desativado automaticamente.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo usado pelo /ia (padrão: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
